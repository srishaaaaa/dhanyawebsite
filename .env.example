# Neon (use the pooled connection string)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Auth.js (generate: openssl rand -base64 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Public URL of the store (used in emails, invoices, sitemap, webhooks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudinary (image/video uploads from the admin)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Razorpay (online payments). Use rzp_test_… keys until you go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Transactional email via Resend (order confirmations, shipping updates, password resets). Optional.
RESEND_API_KEY=
EMAIL_FROM="DHANYA BOUTIQUE <orders@yourdomain.in>"
# Protects /api/cron/release-reservations (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
# First admin (used once by db:seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# End-to-end tests (npm run test:e2e) and database integration tests (npm run test:db)
E2E_BASE_URL=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
TEST_DATABASE_URL=
